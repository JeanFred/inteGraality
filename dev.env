# Local development environment variables (NOT secrets).
#
# Single source of truth for the local MariaDB credentials, consumed by:
#   - docker-compose (loaded via the .env sylink, which both
#     injects DB_* into the web container and provides the values
#     for ${...} substitution that derives the MARIADB_* init vars)
#   - mise (via [env] _.file), so tasks like `reset-db` see the same values
#
# These are throwaway credentials for the local MariaDB container only —
# never used on Toolforge, which reads credentials from ~/replica.my.cnf.

DB_HOST=db
DB_USER=integraality
DB_PASSWORD=password
DB_NAME=s54041__integraality_p

# Character set / collation for the local MariaDB
# (mirrors ToolsDB, whose server defaults are
# character_set_server=utf8mb4, collation_server=utf8mb4_unicode_ci).
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
